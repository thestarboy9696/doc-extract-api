{
  "name": "doc-extract-api",
  "version": "0.2.0",
  "type": "module",
  "description": "SchemaLock — extract structured JSON from invoices, receipts, contracts, resumes, or any document/text via a caller-supplied JSON Schema. This package ships an MCP client for the paid x402 API (Base USDC) — every tool call is a real payment from your own WALLET_PRIVATE_KEY, no free path. Live at https://doc-extract-api.thestarboy9696-4ef.workers.dev.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thestarboy9696/doc-extract-api.git"
  },
  "homepage": "https://github.com/thestarboy9696/doc-extract-api",
  "license": "MIT",
  "mcpName": "io.github.thestarboy9696/doc-extract-api",
  "bin": {
    "doc-extract-api-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "mcp": "tsx mcp/server.ts",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --outfile=dist/mcp-server.js && chmod +x dist/mcp-server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mcp/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/extensions": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "@x402/hono": "^2.23.0",
    "hono": "^4.6.0",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.87.0"
  }
}
